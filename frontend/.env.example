# Public browser key for Maps JS API; never put a real value in this file.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only key for Google Places/Geocoding requests; never expose to the client.
GOOGLE_PLACES_SERVER_KEY=

# Postgres connection string for Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sembakomurah?schema=public"

# Auth.js secret for session signing.
AUTH_SECRET=

# Google OAuth credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Single admin email used for seed and moderator access.
ADMIN_EMAIL=admin@example.com
