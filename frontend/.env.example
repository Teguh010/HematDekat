# Copy to .env.local and fill in. Never commit real values.

# Browser key for the Maps JavaScript API. Restrict it by HTTP referrer in
# Google Cloud Console (localhost and the production domain only).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID from Google Cloud Console (Map Management), required by advanced
# markers. Leave empty in development to use DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Base URL of the NestJS backend, used by browser requests.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: backend URL for server-side requests to public endpoints (server
# components). Defaults to NEXT_PUBLIC_API_URL when empty. Cookies are never
# forwarded from the server.
BACKEND_INTERNAL_URL=
