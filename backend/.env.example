# Postgres connection string for Prisma (docker compose maps host port 5433 -> container 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sembakomurah?schema=public"

# Secret used to sign JWTs issued after login. Must be at least 32 characters.
# Generate one with `openssl rand -base64 48`. The server refuses to start without it.
JWT_SECRET=

# Google OAuth client credentials (separate from the Maps/Places keys).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Server-only key for Google Places/Geocoding requests; never expose to the client.
GOOGLE_PLACES_SERVER_KEY=

# Single admin email used for seed and moderator access.
ADMIN_EMAIL=admin@example.com

# Frontend origin allowed for CORS (with credentials).
CORS_ORIGIN=http://localhost:3000

PORT=3001
